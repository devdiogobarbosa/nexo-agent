# Banco local. Na Vercel use a URL libsql do Turso e o token.
DATABASE_URL=file:./data/nexo.db
DATABASE_AUTH_TOKEN=

# Cookie de sessão. Gere uma string longa e aleatória.
SESSION_SECRET=

# Modelo no formato do Mastra: provedor/modelo. A chave segue o provedor.
LLM_MODEL=openai/gpt-6.1-sol
OPENAI_API_KEY=

# Chance de o serviço de chamados simular indisponibilidade (0 a 1).
TICKET_FAILURE_RATE=0

# Teto diário de mensagens por usuário, além do limite de 30 por sessão.
DAILY_MESSAGE_CAP=80
